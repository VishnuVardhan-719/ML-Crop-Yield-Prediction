{
  "name": "crop-yield-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:api": ".venv\\Scripts\\python.exe -m uvicorn backend.app.main:app --reload --port 8000",
    "test:api": ".venv\\Scripts\\python.exe -m pytest backend/tests -q",
    "lint:api": ".venv\\Scripts\\python.exe -m ruff check backend",
    "format:api": ".venv\\Scripts\\python.exe -m ruff format backend",
    "format:api:check": ".venv\\Scripts\\python.exe -m ruff format --check backend",
    "typecheck:api": ".venv\\Scripts\\python.exe -m ty check backend",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "lint": "oxlint src vite.config.ts",
    "test": "vitest run",
    "check": "npm run lint && npm run typecheck && npm test && npm run lint:api && npm run typecheck:api && npm run test:api",
    "generate:sample": ".venv\\Scripts\\python.exe backend/scripts/generate_sample_dataset.py",
    "generate:demo": ".venv\\Scripts\\python.exe backend/scripts/generate_demo_fixture.py",
    "benchmark:real": ".venv\\Scripts\\python.exe -m backend.scripts.benchmark_real_data",
    "preview": "vite preview"
  },
  "dependencies": {
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/source-serif-4": "^5.3.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^30.0.1",
    "oxlint": "^1.81.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.0"
  }
}
